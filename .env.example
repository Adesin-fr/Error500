# Configuration d'error500. Copier en `.env` (ignoré par git) ; une variable d'environnement
# réelle prime toujours sur ce fichier. `ENV_FILE=/chemin/autre.env` pour un autre emplacement.

# --- Obligatoire ---
# MySQL / MariaDB. Les migrations sont appliquées au démarrage.
DATABASE_URL=mysql://root@127.0.0.1:3306/error500

# --- Serveur ---
BIND=127.0.0.1:8080
# URL publique : sert aux DSN donnés aux SDK et aux liens des emails. Doit correspondre à l'adresse utilisée.
PUBLIC_URL=http://127.0.0.1:8080
# Taille maximale d'un corps de requête, en Mo (après décompression).
MAX_BODY_MB=20

# --- Stockage des replays et des source maps ---
# local (défaut) ou s3
STORAGE=local
STORAGE_PATH=./data/blobs
#STORAGE=s3
#S3_BUCKET=error500
#S3_REGION=eu-west-3
#S3_ENDPOINT=http://127.0.0.1:9000      # MinIO ou autre S3 compatible
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# --- Alertes email (nouvelle issue, régression) ---
# Sans SMTP_URL, les alertes sont désactivées.
#SMTP_URL=smtps://utilisateur:motdepasse@smtp.example.com
#MAIL_FROM=Error500 <errors@example.com>
# Alertes maximum par projet et par heure (0 = illimité).
ALERT_MAX_PER_HOUR=10

# --- Développement ---
# Serveur Vite avec rechargement à chaud (cd frontend && npm run dev).
#VITE_DEV_URL=http://localhost:5173
# Journaux : error, warn, info, debug…
#RUST_LOG=info
